const title = "US Salary Directory 2025 | Average Pay by State & Profession";
const description = "Explore 2025 average salaries, wage benchmarks, and take-home pay across all 50 US states. Compare compensation for top careers from software engineering to nursing.";
---

<Base title={title} description={description} canonical="https://salary.socialninjas.in/salary/">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "US Salary Directory by State",
    "description": description,
    "url": "https://salary.socialninjas.in/salary/"
  })} />

  <div class="container" style="max-width: 1060px; margin: 40px auto; padding: 0 20px;">
    <!-- Breadcrumbs -->
    <nav style="font-size: 13px; color: var(--ink3); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
      <a href="/" style="color: var(--blue); text-decoration: none;">Home</a>
      <span>/</span>
      <span>Salary Directory</span>
    </nav>

    <div style="text-align: center; margin-bottom: 40px;">
      <span style="display:inline-block; padding: 4px 14px; background: rgba(31,75,153,0.08); color: #1F4B99; border-radius: 20px; font-weight: 600; font-size: 13px; margin-bottom: 12px;">
        All 50 US States · 2025 Wage Data
      </span>
      <h1 style="font-size: clamp(28px, 4.5vw, 42px); font-weight: 800; color: #141414; line-height: 1.15; margin-bottom: 14px;">
        US Salary Directory by State
      </h1>
      <p style="font-size: 16px; color: #475569; max-width: 680px; margin: 0 auto; line-height: 1.6;">
        Select your state to explore typical base salaries, state income tax withholding, and take-home pay estimates across 30 high-demand professions.
      </p>
    </div>

    <!-- STATES GRID -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-bottom: 50px;">
      {states.map(st => (
        <a href={`/salary/${st.code}/`} style="background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; text-decoration: none; display: flex; justify-content: space-between; align-items: center; transition: all 0.15s ease;" onmouseover="this.style.borderColor='#1F4B99'; this.style.transform='translateY(-2px)';" onmouseout="this.style.borderColor='var(--border)'; this.style.transform='none';">
          <div>
            <div style="font-size: 15px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">
              {st.name}
            </div>
            <div style="font-size: 12px; color: #64748b;">
              Tax: {st.taxRate} {st.taxRate === '0.0%' ? '🔥 (No Tax)' : ''}
            </div>
          </div>
          <span style="font-size: 14px; color: var(--blue); font-weight: 700;">→</span>
        </a>
      ))}
    </div>
  </div>
</Base>
